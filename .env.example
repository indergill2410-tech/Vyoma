# Copy to .env and fill in. NEVER commit .env to git.

# ── Shopify (commerce backend) ─────────────────────────────
# Shopify owns the catalogue, prices (AUD), checkout and orders. The app reads
# products and creates carts via the Storefront API. Without these the site falls
# back to a read-only local-catalog preview (no checkout) so dev still works.
# Shopify admin → Settings → Apps and sales channels → Develop apps → Create app
#   → enable Storefront API scopes: unauthenticated_read_product_listings,
#     unauthenticated_write_checkouts → Install → copy the Storefront token.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_TOKEN="your-storefront-access-token"
# Webhook signing secret (Shopify admin → webhooks) — enables WhatsApp/SMS
# order updates via /api/shopify-webhook (orders/create, orders/fulfilled).
SHOPIFY_WEBHOOK_SECRET=""

# ── Database (Postgres) ────────────────────────────────────
# Holds ONLY The Circle waitlist + reviews (Shopify owns orders). On Render this
# is wired automatically from the managed Postgres in render.yaml.
DATABASE_URL="postgresql://user:password@localhost:5432/vyoma"

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The date of the first drop, shown in the homepage countdown (ISO 8601).
NEXT_PUBLIC_DROP_DATE="2026-07-15T09:00:00+10:00"

# Simple admin protection — set a long random string.
ADMIN_TOKEN="change-me-to-a-long-random-string"

# ── Twilio (SMS / WhatsApp) ────────────────────────────────
# Drop alerts, order updates, notifications. No-ops when unset.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""            # SMS sender, e.g. +61400000000
TWILIO_WHATSAPP_FROM=""   # WhatsApp sender, e.g. +14155238886 (sandbox ok)

# ── Product image generation (Gemini / Imagen) ─────────────
# Used by `npm run images`. NOTE: image models need a BILLING-enabled Google
# project (the free tier returns quota 0 for image generation).
GEMINI_API_KEY=""
# GEMINI_IMAGE_MODEL="imagen-3.0-generate-002"  # or gemini-2.5-flash-image

# ── Cloudflare (optional: R2 storage / DNS) ────────────────
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# ── Sentry (error monitoring) ──────────────────────────────
# Easiest setup: run `npx @sentry/wizard@latest -i nextjs`.
SENTRY_DSN=""
