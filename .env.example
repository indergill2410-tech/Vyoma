# Copy to .env and fill in. NEVER commit .env to git.

# ── Shopify (headless commerce) ────────────────────────────
# When BOTH are set, the shop grid, product pages and checkout pull live from
# Shopify (real products, photos, hosted checkout). When unset, the app falls
# back to the local catalog + Stripe so dev/preview still works.
# Shopify admin → Settings → Apps and sales channels → Develop apps → Create app
#   → enable Storefront API scopes: unauthenticated_read_product_listings,
#     unauthenticated_write_checkouts → Install → copy the Storefront token.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_TOKEN="your-storefront-access-token"

# ── Database (local/Stripe fallback mode only) ─────────────
# Local dev uses SQLite. For production (Vercel) switch the provider in
# prisma/schema.prisma to "postgresql" and use a Neon/Supabase URL.
DATABASE_URL="file:./dev.db"

# ── Stripe (Australia market) ──────────────────────────────
# https://dashboard.stripe.com/apikeys — use TEST keys first.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."   # from `stripe listen` locally, or the dashboard in prod

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The date of the first drop, shown in the homepage countdown (ISO 8601).
NEXT_PUBLIC_DROP_DATE="2026-07-15T09:00:00+10:00"

# Simple admin protection — set a long random string.
ADMIN_TOKEN="change-me-to-a-long-random-string"
