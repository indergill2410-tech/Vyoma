# Copy to .env and fill in. Never commit .env to git.

# App domain
# Keep this as the Render URL until vyomawear.com.au is connected and resolving.
# After DNS is live in Render/Shopify, set production to:
# NEXT_PUBLIC_SITE_URL="https://vyomawear.com.au"
NEXT_PUBLIC_SITE_URL="https://vyoma-imsr.onrender.com"

# Shopify headless commerce
# Products, variants, stock, prices, checkout, payments, orders and taxes live in Shopify.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_TOKEN="your-storefront-access-token"

# Shopify webhooks for order notifications.
# Configure Shopify webhooks to POST to the active site URL:
# https://vyoma-imsr.onrender.com/api/shopify-webhook now
# https://vyomawear.com.au/api/shopify-webhook after the domain is connected
SHOPIFY_WEBHOOK_SECRET=""

# Database
# Used by waitlist, reviews, admin/supporting app data.
DATABASE_URL="file:./dev.db"

# First-drop/community settings
NEXT_PUBLIC_DROP_DATE="2026-07-15T09:00:00+10:00"
ADMIN_TOKEN="change-me-to-a-long-random-string"

# Twilio (optional SMS / WhatsApp updates)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
TWILIO_WHATSAPP_FROM=""

# Product image generation (optional)
GEMINI_API_KEY=""
# GEMINI_IMAGE_MODEL="imagen-3.0-generate-002"

# Cloudflare (optional: DNS / storage)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Sentry (optional error monitoring)
SENTRY_DSN=""
