// Local dev: SQLite. Production (Vercel): switch provider to "postgresql"
// and point DATABASE_URL at a Neon/Supabase Postgres URL. See README.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// An order is created ONLY by the verified Stripe webhook — never the browser.
model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique // human-friendly, e.g. VY-7F3K2
  stripeSessionId String   @unique
  email           String
  customerName    String?
  region          String   @default("AU") // AU | IN
  items           String // JSON: [{ slug, name, colour, size, quantity, unitAmount }]
  amountTotal     Int // minor units (cents / paise)
  currency        String
  shippingAddress String? // JSON string
  status          String   @default("paid") // paid -> in_production -> shipped -> delivered
  trackingNumber  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Pre-launch / drop waitlist. The pre-order drop is how a $0-capital brand
// funds its first production run (see business plan §9). "The Circle" turns it
// into a referral movement: each member gets a share code; referrals move them
// up the line and up the Founding-Member perk ladder. See lib/circle.js.
model WaitlistEntry {
  id           String   @id @default(cuid())
  email        String
  region       String   @default("AU")
  source       String   @default("homepage") // homepage | product:<slug> | drop | circle
  referralCode String? // this member's own share code (one per email, reused across sources)
  referredBy   String? // the referralCode of whoever brought them in
  createdAt    DateTime @default(now())

  @@unique([email, source])
  @@index([referredBy])
}

// Customer reviews. New reviews land as "pending" and are approved in admin —
// UGC is the brand's ad creative, but it must be moderated.
model Review {
  id          String   @id @default(cuid())
  productSlug String
  author      String
  rating      Int // 1..5
  title       String?
  body        String
  verified    Boolean  @default(false) // true if tied to a real order email
  status      String   @default("pending") // pending | approved | hidden
  createdAt   DateTime @default(now())
}
