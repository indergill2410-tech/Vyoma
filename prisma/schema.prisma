// Production (Render): PostgreSQL. Point DATABASE_URL at the Render Postgres
// connection string. Shopify owns products, checkout and orders — this database
// holds ONLY the things Vyoma owns: The Circle waitlist and moderated reviews.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Pre-launch / drop waitlist. The pre-order drop is how a $0-capital brand
// funds its first production run. "The Circle" turns it into a referral
// movement: each member gets a share code; referrals move them up the line and
// up the Founding-Member perk ladder. See lib/circle.js.
model WaitlistEntry {
  id           String   @id @default(cuid())
  email        String
  region       String   @default("AU")
  source       String   @default("homepage") // homepage | product:<slug> | drop | circle
  referralCode String? // this member's own share code (one per email, reused across sources)
  referredBy   String? // the referralCode of whoever brought them in
  createdAt    DateTime @default(now())

  @@unique([email, source])
  @@index([referredBy])
}

// Customer reviews. New reviews land as "pending" and are approved in admin —
// UGC is the brand's ad creative, but it must be moderated.
model Review {
  id          String   @id @default(cuid())
  productSlug String // Shopify product handle
  author      String
  rating      Int // 1..5
  title       String?
  body        String
  verified    Boolean  @default(false) // true if tied to a real order email
  status      String   @default("pending") // pending | approved | hidden
  createdAt   DateTime @default(now())
}
